{
  "name": "rn-app-foundation",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write App.tsx app.config.ts index.ts \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"plugins/*.js\"",
    "format:check": "prettier --check App.tsx app.config.ts index.ts \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"plugins/*.js\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "api:check": "node scripts/check-api-contract.mjs",
    "config:check": "node scripts/check-build-profiles.mjs",
    "ota:build": "node scripts/build-ota.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm api:check && pnpm config:check",
    "workflow:new": "node scripts/create-change.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@tamagui/animations-react-native": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "~0.10.1",
    "tamagui": "^2.7.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
