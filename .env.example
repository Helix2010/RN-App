EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_DISTRIBUTION_CHANNEL=development
EXPO_PUBLIC_OTA_CHANNEL=development
EXPO_PUBLIC_APPLICATION_ID=dex-mobile
# Machine-level build inputs (copy this file to the git-ignored .env.local).
# Both Expo and `pnpm android:release` read them. The Firebase file may live in
# the git-ignored project directory `secrets/<tenant>/` or outside the repo.
ANDROID_HOME=
GOOGLE_SERVICES_JSON=
# Optional override. Release builds derive this from
# EXPO_PUBLIC_API_BASE_URL as <tenant-api>/v1/ota/manifest.
EXPO_UPDATES_URL=
# Production builds should point at a checked-in public X.509 certificate.
EXPO_UPDATES_CODE_SIGNING_CERTIFICATE=
EXPO_UPDATES_CODE_SIGNING_KEY_ID=main
