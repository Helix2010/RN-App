    "/v1/mobile/bootstrap": {
      "get": {
        "operationId": "BootstrapController_getBootstrap",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "schema": {
              "example": "zh-CN",
              "type": "string"
            }
          },
          {
            "name": "x-app-version",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-build-number",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-platform",
