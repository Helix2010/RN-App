  "info": {
    "title": "RN Foundation API",
    "description": "Mobile bootstrap, localization, theme and update policy",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "BootstrapResponseDto": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "example": 1
          },
          "configVersion": {
            "type": "string",
            "example": "2026.08.21.1"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ttlSeconds": {
            "type": "number",
            "example": 300
          },
          "requestId": {
            "type": "string",
            "example": "req-01"
          },
          "localization": {
            "type": "object",
            "additionalProperties": true
          },
          "theme": {
            "type": "object",
            "additionalProperties": true
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "app": {
            "type": "object",
            "additionalProperties": true
          },
          "update": {
            "type": "object",
            "additionalProperties": true
          },
          "support": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "schemaVersion",
          "configVersion",
          "generatedAt",
          "ttlSeconds",
          "requestId",
          "localization",
          "theme",
          "features",
          "app",
          "update",
          "support"
        ]
      }
    }
  }
